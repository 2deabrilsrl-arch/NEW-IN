# ============================================================
# TIENDANUBE
# ============================================================
# URL base de la API de Tiendanube (NO modificar)
TN_BASE_URL=https://api.tiendanube.com/v1

# ID de tu tienda en Tiendanube
TN_STORE_ID=6566743

# Token de acceso a la API de Tiendanube
TN_ACCESS_TOKEN=accb4de2caf771902f651fe3c2d2877c6a6609c6

# ============================================================
# CATEGORÍA "NEW IN"
# ============================================================
# Nombre de la categoría (usado si no existe)
NEWIN_CATEGORY_NAME=NEW IN

# Handle de la categoría (slug en la URL)
NEWIN_HANDLE=new-in1

# ID específico de la categoría (si se conoce)
# Si este ID no existe o está vacío, el robot buscará por handle/nombre
NEWIN_CATEGORY_ID=34806213

# Permitir crear la categoría si no existe (true/false)
NEWIN_ALLOW_CREATE=true

# ============================================================
# COMPORTAMIENTO
# ============================================================
# Días hacia atrás para catchup si no hay last_run_date
# AUMENTADO A 7 para mayor seguridad (antes era 4)
CATCHUP_DAYS=7

# ============================================================
# RUTAS (MODIFICABLES)
# ============================================================
# Si querés cambiar las rutas, descomentá y configurá estas líneas.
# Si están comentadas, el robot usa rutas automáticas dentro del proyecto.
#
# Directorio base del proyecto (DEFAULT: C:\Users\santiago\NEW IN)
# BASE_DIR=C:\Users\santiago\NEW IN
#
# Directorio para datos persistentes (DEFAULT: {BASE_DIR}\data)
# DATA_DIR=C:\Users\santiago\NEW IN\data
#
# Directorio para logs (DEFAULT: {BASE_DIR}\logs)
# LOG_DIR=C:\Users\santiago\NEW IN\logs

# ============================================================
# NOTAS
# ============================================================
# - El robot consulta Dragonfish con paginación automática (200 items/página)
# - Los logs incluyen timestamps y detalles de errores
# - El estado se guarda en data/state.json después de cada ejecución exitosa
# - El refresh semanal (lunes) limpia la categoría y resetea el estado
# ============================================================
